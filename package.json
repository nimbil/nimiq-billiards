{
  "name": "nimiq-billiards",
  "version": "1.0.0",
  "description": "Multiplayer billiards game integrated with the Nimiq ecosystem",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "build:server": "tsc",
    "preview": "vite preview",
    "start": "node dist-server/index.js",
    "test": "node test/rules-engine.test.js",
    "test:watch": "node --watch test/rules-engine.test.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@nimiq/hub-api": "^1.14.0",
    "@nimiq/mini-app-sdk": "^0.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2",
    "uuid": "^9.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^8.2.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "vite": "^5.0.12"
  }
}
